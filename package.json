{
  "name": "xma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Xiaoyu Management Agent - 小鱼管理智能体",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "vite apps/web",
    "dev:cli": "tsx apps/cli/src/main.ts",
    "dev:server": "tsx apps/server/src/main.ts",
    "dev:desktop": "pnpm --dir apps/desktop run dev:electron",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test core/tests/*.test.ts apps/desktop/tests/*.test.ts",
    "gate:architecture": "tsx scripts/gates/architecture.ts",
    "gate:comments": "tsx scripts/gates/comments.ts",
    "gate:docs": "tsx scripts/gates/documentation.ts",
    "check": "pnpm typecheck && pnpm test && pnpm gate:naming && pnpm gate:architecture && pnpm gate:comments && pnpm gate:docs && pnpm gate:ai-context && pnpm gate:version && pnpm gate:windows && pnpm gate:repo",
    "build:web": "vite build apps/web --outDir ../../dist/web --emptyOutDir",
    "build:cli": "tsup apps/cli/src/main.ts --format esm --platform node --out-dir dist/cli",
    "build:server": "tsup apps/server/src/main.ts --format esm --platform node --out-dir dist/server",
    "build:desktop": "pnpm --dir apps/desktop run build:electron",
    "build": "pnpm build:web && pnpm build:cli && pnpm build:server",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/xma-build-release.ps1 -WindowsPackages",
    "release:current": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/xma-build-release.ps1",
    "gate:version": "tsx scripts/gates/version.ts",
    "gate:windows": "tsx scripts/gates/windows.ts",
    "gate:repo": "tsx scripts/gates/repository.ts",
    "build:all": "pnpm build && pnpm build:desktop:electron",
    "dev:desktop:electron": "pnpm --dir apps/desktop run dev:electron",
    "dev:desktop:tauri": "pnpm --dir apps/desktop run dev:tauri",
    "build:desktop:electron": "pnpm --dir apps/desktop run build:electron",
    "build:desktop:tauri": "pnpm --dir apps/desktop run build:tauri",
    "gate:ai-context": "tsx scripts/gates/ai-context.ts",
    "gate:naming": "tsx scripts/gates/naming.ts"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
