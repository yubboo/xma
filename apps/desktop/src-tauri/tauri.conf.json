{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xiaoyu Management Agent",
  "version": "0.1.0",
  "identifier": "app.xma.desktop",
  "build": {
    "beforeDevCommand": "pnpm run web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run web:build",
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Xiaoyu Management Agent",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
