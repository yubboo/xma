{
  "appId": "app.xma.desktop",
  "productName": "Xiaoyu Management Agent",
  "asar": true,
  "electronVersion": "41.2.0",
  "files": [
    "main/**",
    "web/**",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
