{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "core/**/*.ts",
    "packages/**/*.ts",
    "agents/**/*.ts",
    "plugins/**/*.ts",
    "scripts/**/*.ts"
  ]
}
